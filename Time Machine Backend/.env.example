NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/mystical_past_life
API_BASE_PATH=/api/v1

# AI Provider Configuration
# Set to 'openai' for live generation, or 'mock' for local offline development
AI_PROVIDER_MODE=mock

# OpenAI API Key (Keep exclusively on backend. Never share with frontend or git)
# Note: OpenAI API billing and credits are separate from a ChatGPT Plus subscription.
OPENAI_API_KEY=

# Configurable text and image model IDs
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=dall-e-3

# Storage Configuration (local or s3)
STORAGE_PROVIDER=local
MAX_UPLOAD_BYTES=5242880
READING_RETENTION_DAYS=30
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=60

# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed browser origins (enforced in production).
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/time_machine
API_BASE_PATH=/api/v1

# ─── AI provider ──────────────────────────────────────────────────────────────
# 'openai' for live generation, 'mock' for fully offline local development.
# Both the Time Machine (past) and 2050 (future) timelines use this one switch.
#
# In 'mock' mode portraits are SVG placeholders, not generated images. The
# server checks the key at boot and says so loudly if live generation will not
# work; `npm run doctor` checks the same thing before you start.
AI_PROVIDER_MODE=openai

# Keep this key on the backend only. Never expose it to the frontend or commit it.
# OpenAI API billing is separate from a ChatGPT subscription.
OPENAI_API_KEY=

# Text model used for both the past-life chronicle and the 2050 chronicle.
OPENAI_TEXT_MODEL=gpt-4o-mini

# Image model. gpt-image-1 returns base64 and supports identity-preserving edits
# from a reference photo; dall-e-3 returns a URL and ignores edit requests.
OPENAI_IMAGE_MODEL=gpt-image-1
# Portrait aspect. 1024x1536 is portrait, 1024x1024 square, 1536x1024 landscape.
OPENAI_IMAGE_SIZE=1024x1536

# Output format. A 1024x1536 PNG is ~2.4 MB and takes nine seconds to reach a
# reader on a slow connection; the same portrait as WebP is ~145 KB. Set png
# only if you need lossless output.
OPENAI_IMAGE_FORMAT=webp
OPENAI_IMAGE_COMPRESSION=80

# ─── Storage & limits ─────────────────────────────────────────────────────────
# local    portraits and reference photos are written to ./uploads
# mongodb  they are stored in the database instead
#
# Use mongodb anywhere hosted. A platform web service has an ephemeral
# filesystem — anything written to disk is gone on the next deploy, which would
# leave every saved reading pointing at a portrait that no longer exists.
STORAGE_PROVIDER=local
MAX_UPLOAD_BYTES=5242880
READING_RETENTION_DAYS=30
# Read budget per IP. A single reading costs ~35 status polls, so this is sized
# for shared connections (a venue, an office, an expo kiosk) rather than per person.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1200

# Generation budget per IP — the call that actually spends provider credits.
CREATION_RATE_LIMIT_WINDOW_MS=300000
CREATION_RATE_LIMIT_MAX=20

# Upload budget per IP.
UPLOAD_RATE_LIMIT_WINDOW_MS=300000
UPLOAD_RATE_LIMIT_MAX=20
